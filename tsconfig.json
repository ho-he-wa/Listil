{
  "compilerOptions": {
    "target": "ES2020", // Service Worker対応のため ES2020 以上推奨
    "lib": [
      "DOM",
      "ES2020"
    ], // DOM操作とES2020のAPI使用可能
    "module": "ESNext", // モダンなモジュールシステム
    "moduleResolution": "bundler", // Node風のモジュール解決
    // "outDir": "dist", // 出力先
    "rootDir": "src", // ソースコードのルート
    "strict": true, // 厳格な型チェック
    "esModuleInterop": true, // CommonJSとの互換性
    "skipLibCheck": true, // 型定義のチェックをスキップ（高速化）
    "forceConsistentCasingInFileNames": true, // ファイル名の大文字小文字の一貫性を強制
    "noEmitOnError": true, // エラーがあるときは出力しない
    "resolveJsonModule": true, // JSONインポート許可
    "allowJs": false, // JSファイルは無効（必要なら true）
    "noEmit": true,
    "isolatedModules": true, // 各ファイルを独立モジュールとして扱う
    "sourceMap": true,
    "types": [
      "chrome"
    ] // `chrome` API 型定義を読み込む
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}