{
  "manifest_version": 3,
  "name": "Listil",
  "version": "1.0",
  "description": "A utility for lists that can apply patterns to highlight, gray out, or hide entries.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "toggle.css"
      ],
      "run_at": "document_idle"
    }
  ]
}