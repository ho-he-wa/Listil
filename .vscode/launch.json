{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome with Extension",
      "url": "https://www.google.com", // 任意のデバッグ対象ページ
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/public",
        "--user-data-dir=${workspaceFolder}/.vscode/chrome-user-data"
      ]
    }
  ]
}